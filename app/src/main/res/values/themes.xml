<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.tooai" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Hosts the AI Writer sheet over whatever app the user came from. -->
    <style name="Theme.tooai.Transparent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>